# ==============================================================================
# KKS TIMIKA PLATFORM - ENVIRONMENT VARIABLES (ROOT TEMPLATE)
# ==============================================================================
# Salin file ini menjadi `.env` atau konfigurasikan di Environment Variables CI/CD / Vercel.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/kks_platform_db

# ------------------------------------------------------------------------------
# 2. DOMAIN & APP URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3009
NEXT_PUBLIC_ADMIN_URL=http://localhost:3008

# ------------------------------------------------------------------------------
# 3. IDENTITAS & INTEGRASI KOMUNITAS KKS TIMIKA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ORG_NAME="Kerukunan Keluarga Soppeng (KKS) Kabupaten Mimika"
NEXT_PUBLIC_WA_CHANNEL_URL=https://whatsapp.com/channel/*
NEXT_PUBLIC_HOTLINE_WA=6281234567890
NEXT_PUBLIC_SECRETARIAT_EMAIL=sekretariat@kks-mimika.org
NEXT_PUBLIC_SECRETARIAT_ADDRESS="Distrik Mimika Baru, Kota Timika, Papua Tengah"

# ------------------------------------------------------------------------------
# 4. REKENING RESMI KAS SOSIAL & SANTUNAN PAGUYUBAN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BANK_NAME="Bank Rakyat Indonesia (BRI)"
NEXT_PUBLIC_BANK_ACCOUNT_NO="0321-01-001234-53-9"
NEXT_PUBLIC_BANK_ACCOUNT_HOLDER="KKS KABUPATEN MIMIKA"

# ------------------------------------------------------------------------------
# 5. STORAGE PROVIDER CONFIGURATION ('local' atau 'supabase')
# ------------------------------------------------------------------------------
# 'local': Berkas disimpan di folder /public/uploads/ (tidak terunggah ke git)
# 'supabase': Otomatis mengunggah ke Supabase Storage Bucket menggunakan REST SDK
STORAGE_PROVIDER=local

# Kredensial Supabase (Wajib jika STORAGE_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJh......
SUPABASE_SERVICE_ROLE_KEY=eyJh......
SUPABASE_STORAGE_BUCKET=kks-media
